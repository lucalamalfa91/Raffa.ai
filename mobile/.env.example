# Per-environment mobile config (ADR-013, ADR-010). Copy to .env (or
# .env.local for a personal override — see .gitignore) and fill in the
# values for the environment you are running against (dev/demo).
#
# All three are read at build/start time by Metro's EXPO_PUBLIC_* inlining
# (src/config/env.ts) — none of them is a secret:
#   - the API base URL is public (it is the address the app calls);
#   - the OIDC authority is the public Entra ID discovery issuer;
#   - the OIDC client ID is a public-client identifier (ADR-010: PKCE
#     public clients carry no client secret — never add one here).

# Backend API origin for this environment, e.g. https://api-dev.raffa.example
EXPO_PUBLIC_API_BASE_URL=

# Entra ID OIDC authority (issuer) for this environment's tenant, e.g.
# https://login.microsoftonline.com/<tenant-id>/v2.0
EXPO_PUBLIC_OIDC_AUTHORITY=

# Entra ID public-client application (client) ID registered for this
# environment (ADR-010: one public-client registration per env, shared by
# web + mobile via different reply URL types).
EXPO_PUBLIC_OIDC_CLIENT_ID=

# API scopes requested at sign-in, comma-separated (ADR-010 names
# "Raffa.Read"/"Raffa.Write" as placeholders until the API surface is
# fixed by software-architect — see reports/open-questions.md OQ-client-007).
# Do not list "openid"/"profile"/"offline_access" here: the app adds those
# standard OIDC scopes automatically (src/auth/oidcConfig.ts).
# e.g. api://<api-client-id>/Raffa.Read,api://<api-client-id>/Raffa.Write
EXPO_PUBLIC_OIDC_API_SCOPES=

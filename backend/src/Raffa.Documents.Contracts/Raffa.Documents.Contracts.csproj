<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
    <ProjectReference Include="..\Raffa.AiGateway\Raffa.AiGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E22/F02/US01/T01 (OQ-w17-sa-04 binding): PDF rasteriser.
         Package : Docnet.Core (MIT)
         Licence : MIT
         Linux native-dependency list : EMPTY — Docnet.Core bundles a statically linked pdfium
                   binary via NuGet native assets (RID-specific .so embedded in the nupkg), so
                   no apt-get layer is owed in backend/src/Raffa.Worker/Dockerfile.
         Verified against base image mcr.microsoft.com/dotnet/runtime:10.0 (slim Debian 12);
         pdfium's Skia-based renderer needs no fontconfig, freetype, libpng, libjpeg or
         libgdiplus — all statically linked. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Raffa.Documents.Contracts.Tests" />
  </ItemGroup>

</Project>

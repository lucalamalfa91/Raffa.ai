<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
    <ProjectReference Include="..\Raffa.Benchmark\Raffa.Benchmark.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E03/F01/US01/T01 (deterministic-dates): this module's own
         AddRenewalsModule(IServiceCollection) composition-root wiring
         (Infrastructure/ServiceCollectionExtensions.cs) — ADR-002's "each module exposes an
         AddXxx(IServiceCollection) extension method". Same generic .NET hosting abstraction (not
         a provider SDK) Raffa.Chat.csproj/Raffa.AiGateway.csproj already reference for the
         identical reason — does not trip
         Raffa.ArchitectureTests.DependencyDirectionTests.Domain_module_must_not_reference_provider_sdks. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- Task E03/F02/US01/T01 (threshold-scheduler): ThresholdWindowOptions binds from
         IConfiguration inside AddRenewalsModule, the same generic .NET configuration abstraction
         (not a provider SDK) Raffa.AiGateway.csproj already references for the identical
         AiGatewayModelOptions/AiGatewayOcrOptions pattern. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <!-- Task E03/F03/US01/T02 (renewal-action): this module's first DbContext
         (RenewalsDbContext) — same three packages Raffa.Audit.csproj already references for the
         identical reason (Npgsql provider + snake_case naming convention + `dotnet ef` design-time
         tooling). Not a "provider SDK" for Raffa.ArchitectureTests.DependencyDirectionTests
         .Domain_module_must_not_reference_provider_sdks' purposes (that rule forbids Azure/AI/
         cloud SDKs, not the relational-store ORM every module already uses). -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

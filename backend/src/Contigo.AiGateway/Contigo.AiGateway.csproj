<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Contigo.SharedKernel\Contigo.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E02/F01/US02/T01: this module's own AddAiGatewayModule(IServiceCollection)
         composition-root wiring (ServiceCollectionExtensions.cs) — ADR-002's "each module
         exposes an AddXxx(IServiceCollection) extension method", not yet done when this project
         was created because no host took a dependency on IAiGateway yet
         (AiGatewayModelOptions's own doc comment names this task as "the first caller"). These
         are generic .NET hosting/config abstractions, not a provider SDK, so they do not trip
         Contigo.ArchitectureTests.DependencyDirectionTests.Domain_module_must_not_reference_provider_sdks
         (Worker already references the same-family Microsoft.Extensions.Hosting for the same
         reason). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E13/F01/US01/T02 (foundry-gateway): the only Azure SDK references in this whole
         solution (Contigo.AiGateway.Tests.SdkAllowListTests fails the build if any other csproj
         adds one). Azure.Identity's DefaultAzureCredential is the managed-identity auth this
         task's coding objective requires ("auth via DefaultAzureCredential..., never a key");
         Azure.Core supplies the TokenCredential/TokenRequestContext/AccessToken types
         FoundryTokenProvider uses directly. Chat/extract/embed/OCR request bodies themselves are
         hand-serialized System.Text.Json DTOs (Foundry/Wire/*) over a plain HttpClient, not a
         higher-level Azure.AI.* client SDK — see FoundryHttpJsonClient's own doc comment for why:
         owning the exact JSON keys sent is what makes the answer role's "no tools/tool_choice/
         grounding" compliance a type-system guarantee, provable on a fake HttpMessageHandler in
         tests, rather than an SDK-version-dependent implementation detail. -->
    <PackageReference Include="Azure.Core" Version="1.50.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
    <ProjectReference Include="..\Raffa.Documents.Contracts\Raffa.Documents.Contracts.csproj" />
    <!-- Task E16/F02/US03/T01 (ADR-027 D2/D3, ADR-002 w15 footer): the Worker is the consumer of the
         extraction queue and needs the blob adapter to read the bytes it processes. -->
    <ProjectReference Include="..\Raffa.Messaging\Raffa.Messaging.csproj" />
    <ProjectReference Include="..\Raffa.Storage\Raffa.Storage.csproj" />
    <ProjectReference Include="..\Raffa.Renewals\Raffa.Renewals.csproj" />
    <ProjectReference Include="..\Raffa.Savings\Raffa.Savings.csproj" />
    <ProjectReference Include="..\Raffa.Quotes\Raffa.Quotes.csproj" />
    <ProjectReference Include="..\Raffa.AiGateway\Raffa.AiGateway.csproj" />
    <ProjectReference Include="..\Raffa.Benchmark\Raffa.Benchmark.csproj" />
    <ProjectReference Include="..\Raffa.Audit\Raffa.Audit.csproj" />
    <!-- Task E13/F02/US01/T02 (market-index): Commands/IngestMarketCommand.cs (the `ingest-market`
         operator command) calls Raffa.Market.Ingestion.MarketIngestionService; Program.cs calls
         Raffa.Market.ServiceCollectionExtensions.AddMarketModule. -->
    <ProjectReference Include="..\Raffa.Market\Raffa.Market.csproj" />
    <!-- The extraction pipeline resolves Contract.SupplierId through ISupplierResolver; without
         this module on the Worker host, LinkSupplierAsync no-ops and Portfolio/Renewals show "—". -->
    <ProjectReference Include="..\Raffa.Suppliers.Products\Raffa.Suppliers.Products.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Contigo.SharedKernel\Contigo.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E13/F03/US01/T01 (supplier-entity): this module's first DbContext
         (SuppliersDbContext) — same three packages Contigo.Renewals.csproj already references for
         the identical reason (Npgsql provider + snake_case naming convention + `dotnet ef`
         design-time tooling). Not a "provider SDK" for
         Contigo.ArchitectureTests.DependencyDirectionTests.Domain_module_must_not_reference_provider_sdks'
         purposes (that rule forbids Azure/AI/cloud SDKs, not the relational-store ORM every module
         already uses). No pgvector package: this module has no embedding/vector column. -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

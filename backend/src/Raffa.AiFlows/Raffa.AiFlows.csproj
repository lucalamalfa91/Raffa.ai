<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Raffa.AiFlows sits ABOVE the domain modules (ADR-002 amendment, "AI flows layer"): it
         orchestrates them and holds the AI logic (orchestrators, agents, prompts, JSON schemas,
         guards, lexicons). It may reference the kernel, the gateway and the domain modules; it is
         referenced only by the hosts (Raffa.Api, Raffa.Worker). No module references it, so the
         graph stays acyclic. Never Api, Worker, Tools, Messaging, Storage:
         Raffa.ArchitectureTests.DependencyDirectionTests.AiFlows_references_only_modules_and_kernel. -->
    <ProjectReference Include="..\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
    <ProjectReference Include="..\Raffa.AiGateway\Raffa.AiGateway.csproj" />
    <ProjectReference Include="..\Raffa.Chat\Raffa.Chat.csproj" />
    <ProjectReference Include="..\Raffa.Documents.Contracts\Raffa.Documents.Contracts.csproj" />
    <ProjectReference Include="..\Raffa.Quotes\Raffa.Quotes.csproj" />
    <ProjectReference Include="..\Raffa.Market\Raffa.Market.csproj" />
    <ProjectReference Include="..\Raffa.Insights\Raffa.Insights.csproj" />
    <ProjectReference Include="..\Raffa.Benchmark\Raffa.Benchmark.csproj" />
    <ProjectReference Include="..\Raffa.Renewals\Raffa.Renewals.csproj" />
    <ProjectReference Include="..\Raffa.Savings\Raffa.Savings.csproj" />
    <ProjectReference Include="..\Raffa.Suppliers.Products\Raffa.Suppliers.Products.csproj" />
    <ProjectReference Include="..\Raffa.Identity.Workspace\Raffa.Identity.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic .NET hosting abstractions (not provider SDKs, not persistence packages): same
         family and version every module already references. AiFlows must not take a direct
         Azure/OpenAI/Microsoft.Graph/EF Core/Npgsql/Pgvector package reference:
         Raffa.ArchitectureTests.DependencyDirectionTests.AiFlows_must_not_reference_provider_sdks_or_persistence_packages. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Task E13/F01/US01/T01: ServiceCollectionExtensionsTests proves AddInsightsModule's own
         (currently empty) DI wiring resolves — mirrors Raffa.Benchmark.Tests.csproj /
         Raffa.AiGateway.Tests.csproj's identical package for the same reason. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raffa.Insights\Raffa.Insights.csproj" />
    <!-- Task E13/F07/US01/T01 (insights-calculators): this task's own "Tests required" table pins
         "endpoint composition" tests here, not Raffa.Api.Tests — InsightsEndpointExtensions.cs's
         public composition/mapping methods are unit-tested directly with hand-built fakes
         (Contract360Result, PortfolioListItem, SavingsOpportunityResult, ...), no database, no
         WebApplicationFactory (the routes are unmapped this task — nothing would be reachable over
         HTTP yet). Raffa.ArchitectureTests.DependencyDirectionTests only constrains src/ projects
         (see its own FindSolutionRoot/GetDomainModules — csprojPath is always under "src"), so a
         test project referencing the host is not an architecture-test violation, the same way
         Raffa.Api.Tests.csproj already references Raffa.Documents.Contracts/Raffa.SharedKernel
         directly alongside Raffa.Api for the identical "name every project whose types you use"
         clarity. -->
    <ProjectReference Include="..\..\src\Raffa.Api\Raffa.Api.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Documents.Contracts\Raffa.Documents.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Renewals\Raffa.Renewals.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Savings\Raffa.Savings.csproj" />
    <!-- AC-3's cross-calculator equivalence proof ("priced-line targets equal the quote
         calculator's for identical inputs") needs the real Raffa.Quotes calculator/domain types
         alongside Raffa.Insights' own. -->
    <ProjectReference Include="..\..\src\Raffa.Quotes\Raffa.Quotes.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Benchmark\Raffa.Benchmark.csproj" />
    <ProjectReference Include="..\..\src\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Task E13/F01/US01/T01: ServiceCollectionExtensionsTests proves AddInsightsModule's own
         (currently empty) DI wiring resolves — mirrors Contigo.Benchmark.Tests.csproj /
         Contigo.AiGateway.Tests.csproj's identical package for the same reason. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Contigo.Insights\Contigo.Insights.csproj" />
    <!-- Task E13/F07/US01/T01 (insights-calculators): this task's own "Tests required" table pins
         "endpoint composition" tests here, not Contigo.Api.Tests — InsightsEndpointExtensions.cs's
         public composition/mapping methods are unit-tested directly with hand-built fakes
         (Contract360Result, PortfolioListItem, SavingsOpportunityResult, ...), no database, no
         WebApplicationFactory (the routes are unmapped this task — nothing would be reachable over
         HTTP yet). Contigo.ArchitectureTests.DependencyDirectionTests only constrains src/ projects
         (see its own FindSolutionRoot/GetDomainModules — csprojPath is always under "src"), so a
         test project referencing the host is not an architecture-test violation, the same way
         Contigo.Api.Tests.csproj already references Contigo.Documents.Contracts/Contigo.SharedKernel
         directly alongside Contigo.Api for the identical "name every project whose types you use"
         clarity. -->
    <ProjectReference Include="..\..\src\Contigo.Api\Contigo.Api.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Documents.Contracts\Contigo.Documents.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Renewals\Contigo.Renewals.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Savings\Contigo.Savings.csproj" />
    <!-- AC-3's cross-calculator equivalence proof ("priced-line targets equal the quote
         calculator's for identical inputs") needs the real Contigo.Quotes calculator/domain types
         alongside Contigo.Insights' own. -->
    <ProjectReference Include="..\..\src\Contigo.Quotes\Contigo.Quotes.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Benchmark\Contigo.Benchmark.csproj" />
    <ProjectReference Include="..\..\src\Contigo.SharedKernel\Contigo.SharedKernel.csproj" />
  </ItemGroup>

</Project>

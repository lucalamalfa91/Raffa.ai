<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Task E02/F04/US02/T01: ServiceCollectionExtensionsTests proves AddChatModule's own DI
         wiring (mirrors Raffa.AiGateway.Tests.csproj's identical package for the same reason). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Task E13/F05/US01/T01 (conversations-store): ConversationServiceTests / ChatMigrationScriptTests
         both need a real Postgres+RLS Testcontainer — same package Raffa.Documents.Contracts.Tests.csproj
         / Raffa.Audit.Tests.csproj carry for the identical reason; Npgsql itself flows
         transitively through the ProjectReference below (Raffa.Chat.csproj now references
         Npgsql.EntityFrameworkCore.PostgreSQL), same as those two test projects. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raffa.Chat\Raffa.Chat.csproj" />
  </ItemGroup>

</Project>

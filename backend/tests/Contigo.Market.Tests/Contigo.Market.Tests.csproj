<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Task E13/F01/US01/T01: ServiceCollectionExtensionsTests proves AddMarketModule's own
         (currently empty) DI wiring resolves — mirrors Contigo.Benchmark.Tests.csproj /
         Contigo.AiGateway.Tests.csproj's identical package for the same reason. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!-- Task E13/F02/US01/T01: tests build a real IConfiguration (empty, or with an explicit
         "Benchmark:Adapter:ActiveAdapter" override) to prove AddMarketModule's default-active-
         adapter override — same two packages Contigo.Benchmark.Tests.csproj already references
         for its own AddBenchmarkModule tests. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <!-- Task E13/F02/US01/T02 (market-index): MarketMigrationScriptTests,
         MarketIngestionServiceTests, PgVectorMarketKnowledgeRetrievalTests,
         MarketFeedBenchmarkAdapterDbBackedTests and MarketModuleQuestionTimeIsolationTests all
         spin up a disposable Postgres+pgvector via Testcontainers, the same two packages every
         other module's own DB-backed test project already references
         (Contigo.Documents.Contracts.Tests, Contigo.Suppliers.Products.Tests, ...). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- DbContextOptionsBuilder<T>/PooledDbContextFactory<T>/Database.MigrateAsync()/async LINQ,
         same package Contigo.Market.csproj itself references, so this test project needs no
         separate version to track. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Contigo.Market\Contigo.Market.csproj" />
  </ItemGroup>

</Project>

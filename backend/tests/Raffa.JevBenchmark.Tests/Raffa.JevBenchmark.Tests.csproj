<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The labelled case sets are data, not code. classify-cases.v1.json is this project's own small
         synthetic set (provenance is written inside the file); the investigator set is the checked-in
         INV-04 set of Raffa.AiEval, linked rather than copied so there is a single source of truth. -->
    <Content Include="cases\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Raffa.AiEval\investigator-set\investigator-eval.v1.json"
             Link="cases\investigator-eval.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raffa.AiFlows\Raffa.AiFlows.csproj" />
    <ProjectReference Include="..\..\src\Raffa.AiGateway\Raffa.AiGateway.csproj" />
    <ProjectReference Include="..\..\src\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
  </ItemGroup>

</Project>

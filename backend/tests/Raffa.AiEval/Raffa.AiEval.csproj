<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Task E13/F06/US01/T02 (ask-golden-set): the golden set runs the *whole* Ask V2 pipeline
         through the real host (`POST /api/chat/query` -> AskCopilotService), so it needs the same
         WebApplicationFactory + EF Core InMemory pair Raffa.Api.Tests already uses to prove the
         engine without a running Postgres (see TenantFixtures/AskEvalHost.cs). Versions pinned to
         the ones Raffa.Api.Tests already resolves, so the whole solution keeps one
         Microsoft.EntityFrameworkCore version. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden set is data, not code: the cases live in `golden/*.json` so a reviewer (or a
         HITL pass on `demo`) can read and extend them without touching C#. Copied next to the test
         assembly so the loader finds them from AppContext.BaseDirectory when the repo layout is
         not available (a packaged/CI run), while GoldenSet.cs prefers the source-tree copy so an
         edit is picked up without a rebuild of the JSON itself. -->
    <Content Include="golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E13/F01/US01/T01 (v2-scaffold) scoped this project to Chat/AiGateway/SharedKernel
         references only. Task E13/F06/US01/T02 (ask-golden-set) adds the composition root itself
         (Raffa.Api, for `Program` + the whole registered graph) plus the three tenant-store
         modules whose DbContexts the tenant fixtures seed directly (Documents/Contracts for
         contracts, Suppliers/Products for supplier names, Savings for the empty opportunity list
         the portfolio-strategy pack reads). Everything else the engine touches — Market, Insights,
         Renewals, Benchmark, Audit — arrives transitively through Raffa.Api and needs no
         reference here because this project never names those types. -->
    <ProjectReference Include="..\..\src\Raffa.Api\Raffa.Api.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Chat\Raffa.Chat.csproj" />
    <ProjectReference Include="..\..\src\Raffa.AiGateway\Raffa.AiGateway.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Documents.Contracts\Raffa.Documents.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Savings\Raffa.Savings.csproj" />
    <ProjectReference Include="..\..\src\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Suppliers.Products\Raffa.Suppliers.Products.csproj" />
  </ItemGroup>

</Project>

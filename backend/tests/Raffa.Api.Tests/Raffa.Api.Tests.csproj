<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Task E13/F06/US01/T01 (ask-engine, review pass): lets ChatEndpointTests/
         ConversationsEndpointTests swap DocumentsContractsDbContext/ChatDbContext onto the
         InMemory provider (InMemoryAskEngineFactory), so a full Ask-engine HTTP round trip can be
         proven in this project without a running Postgres — see that helper's own doc comment.
         Pinned to the same version as Microsoft.EntityFrameworkCore.Design (Raffa.Documents.Contracts.csproj)
         so both resolve to one shared Microsoft.EntityFrameworkCore version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Task E14/F03/US01/T01 (wave w14): WorkspaceDirectoryEndpointTests' T1a needs a real,
         RLS-enforcing Postgres (the identity_self policy has no InMemory-provider equivalent —
         dropping the identity scope must make RLS itself deny every row, which only a real
         Postgres connection can prove), the same package/version every *RlsCrossTenantIsolationTests
         class across this solution already depends on. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raffa.Api\Raffa.Api.csproj" />
    <ProjectReference Include="..\..\src\Raffa.AiGateway\Raffa.AiGateway.csproj" />
    <!-- Task E18/F02/US02/T01 (wave w16, NW-08): GET /api/audit is reachable now, and
         AuditEndpointTests seeds/reads Raffa.Audit.Infrastructure.AuditDbContext directly (the
         same "own DbContext, bypass the HTTP write path" shape InMemoryAskEngineFactory's own
         SeedContractAsync already uses) rather than through a real Postgres-backed IAuditWriter. -->
    <ProjectReference Include="..\..\src\Raffa.Audit\Raffa.Audit.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Chat\Raffa.Chat.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Documents.Contracts\Raffa.Documents.Contracts.csproj" />
    <!-- Task E13/F04/US01/T02: the in-memory host swaps IdentityWorkspaceDbContext so
         WorkspaceRoleResolver's membership branch is exercised without a real Postgres. -->
    <ProjectReference Include="..\..\src\Raffa.Identity.Workspace\Raffa.Identity.Workspace.csproj" />
    <!-- Task E19/F01/US01/T01: GET /api/renewals now embeds savedAction via RenewalsDbContext,
         so InMemoryAskEngineFactory must swap that context too (same as DocumentsContracts). -->
    <ProjectReference Include="..\..\src\Raffa.Renewals\Raffa.Renewals.csproj" />
    <ProjectReference Include="..\..\src\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
  </ItemGroup>

</Project>

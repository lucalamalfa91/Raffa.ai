<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Task E13/F03/US01/T01 (supplier-entity): SupplierCrossTenantIsolationTests builds its own
         dedicated, deliberately unprivileged Postgres role (NpgsqlConnectionStringBuilder) the same
         way Raffa.Renewals.Tests's own *RlsCrossTenantIsolationTests already do — Suppliers/
         Products is not wired into the Raffa.Api host yet (task E13/F06/US01/T01), so this test
         cannot go through R0IntegrationFixture's WebApplicationFactory<Program> like the R0-R4
         suites above; it drives Infrastructure.SuppliersDbContext directly instead. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- Task E13/F02/US01/T02 (market-index): MarketIndexIsolationTests seeds a market_embedding
         row directly (same technique PgVectorMarketKnowledgeRetrievalTests already uses in
         Raffa.Market.Tests), so this project needs the Vector CLR type by name too. -->
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raffa.Api\Raffa.Api.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Identity.Workspace\Raffa.Identity.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Documents.Contracts\Raffa.Documents.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Audit\Raffa.Audit.csproj" />
    <ProjectReference Include="..\..\src\Raffa.SharedKernel\Raffa.SharedKernel.csproj" />
    <!-- Task E02/F04/US02/T01: AskRaffaRagCrossTenantIsolationTests composes
         EmbeddingRetrievalService (Documents.Contracts, already referenced above) with the real
         POST /api/chat/query host (Raffa.Api, which already references both of these
         transitively) — explicit here for the same directness every other reference in this file
         already has, not because compilation would fail without it. -->
    <ProjectReference Include="..\..\src\Raffa.Chat\Raffa.Chat.csproj" />
    <ProjectReference Include="..\..\src\Raffa.AiGateway\Raffa.AiGateway.csproj" />
    <!-- Task E03/F04/US01/T01 (r2-integration): R2EndToEndTests/R2CrossTenantIsolationTests
         resolve Raffa.Renewals.Application types (RenewalThresholdScheduler, ContractRenewalTerms,
         RenewalActionService, RenewalMilestoneKind, ...) directly from the host's own container and
         construct DTOs by hand — Raffa.Api already references this module transitively, but a
         test file needs the compile-time type names, not just the transitive runtime assembly. -->
    <ProjectReference Include="..\..\src\Raffa.Renewals\Raffa.Renewals.csproj" />
    <!-- Task E04/F04/US01/T01 (r3-integration): R3EndToEndTests/R3CrossTenantIsolationTests resolve
         Raffa.Savings.Application/Domain types (SavingsOpportunityService,
         CreateSavingsOpportunityRequest, SavingsOpportunityStatus, ...) and Raffa.Benchmark.Contracts/
         Adapters types (IBenchmarkService, BenchmarkQuery, IBenchmarkProviderAdapter,
         FixtureBenchmarkAdapter, ...) directly from the host's own container and construct DTOs by
         hand — same "Raffa.Api already references this transitively, but a test file needs the
         compile-time type names" reasoning as the Raffa.Renewals reference just above. -->
    <ProjectReference Include="..\..\src\Raffa.Savings\Raffa.Savings.csproj" />
    <ProjectReference Include="..\..\src\Raffa.Benchmark\Raffa.Benchmark.csproj" />
    <!-- Task E05/F01/US01/T01 (quote-extraction): QuoteEndToEndTests resolves
         Raffa.Quotes.Infrastructure.QuotesDbContext directly from the host's own container to
         assert on persisted QuoteLine rows (evidence/confidence, AC-2) — same "Raffa.Api already
         references this transitively, but a test file needs the compile-time type names" reasoning
         as the Raffa.Savings/Raffa.Renewals references above. -->
    <ProjectReference Include="..\..\src\Raffa.Quotes\Raffa.Quotes.csproj" />
    <!-- Task E13/F03/US01/T01 (supplier-entity): SupplierCrossTenantIsolationTests resolves
         Raffa.Suppliers.Products.Infrastructure.SuppliersDbContext / Domain.Supplier directly —
         Raffa.Api does not reference this module yet, so unlike the other references in this
         file there is no existing transitive path to it. -->
    <ProjectReference Include="..\..\src\Raffa.Suppliers.Products\Raffa.Suppliers.Products.csproj" />
    <!-- Task E13/F02/US01/T02 (market-index): MarketIndexIsolationTests resolves
         Raffa.Market.Infrastructure.MarketDbContext / Retrieval.PgVectorMarketKnowledgeRetrieval
         directly — Raffa.Api does not reference Raffa.Market yet (MarketEndpointExtensions.cs
         is not mapped from Program.cs this phase), so unlike the transitive references above there
         is no existing path to it; same reasoning as the Raffa.Suppliers.Products reference above. -->
    <ProjectReference Include="..\..\src\Raffa.Market\Raffa.Market.csproj" />
  </ItemGroup>

</Project>

# =============================================================================
# contigo-flow -- artifact environment
# =============================================================================
#   cp .env.example .env
#
# ./run.sh exports these before launching helix. Unset ${VAR} in the YAML is a
# hard bind error. Fill every key, even with a placeholder, for unused services.
# NEVER commit .env.
# =============================================================================

# --- DeepSeek (or any OpenAI-compatible chat endpoint) -----------------------
# base_url WITHOUT /v1 when using api.deepseek.com (root mounts OpenAI + Anthropic).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Model ids. V4 (and the deepseek-chat alias) enable thinking by default;
# the artifact YAML disables it via extra_body.thinking.type=disabled.
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-chat

# --- Claude Code (passata 2) -------------------------------------------------
# Default for overnight waves: Claude Code Max via `claude login`.
# Leave the Hub URL/token empty (or run with --max) so CC does not bill the Hub
# or Console API. ANTHROPIC_API_KEY must stay UNSET (run.sh refuses it).
#
# Optional AI Hub (NOT Max, NOT passata-2 default):
# ANTHROPIC_BASE_URL=https://adesso-ai-hub.3asabc.de
# ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
# Passata 1 Ask V2 (contigo-ask-process.yaml / run-ask.ps1): Claude Code Opus.
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
# Coding-agent turn deadlines (Helix >= 2026-09-09). DEADLINE is an INACTIVITY
# deadline: re-armed on every streamed message, it fires only when the claude
# subprocess is silent that long (a hang) -- never because a turn is long. Keep it
# above the longest silent command a turn may run (reviewer rule: 300 s per Bash
# call; implementer rule: 10 min). MAX is the absolute cap per turn (0 = unbounded;
# execution-loop run_timeout_s = 4 h is then the ceiling). Both are read when the
# backend imports the coding-agent client: restart the Studio backend after a change.
# The old total-turn cap (3600) killed four healthy e13 turns before `git commit`.
HELIX_CODING_AGENT_TURN_DEADLINE_SECONDS=900
HELIX_CODING_AGENT_TURN_MAX_SECONDS=10800
# Set to 1 to skip the `dotnet build` gate merge_verify.py runs after a barrier
# conflict that touched backend C# sources (never in an overnight wave).
# MERGE_VERIFY_SKIP_BUILD=

# In Claude Code: /config → "Continue automatically at usage limit" = on
# (v2.1.234+). That is the in-session wait. The overnight wrapper is the
# outer retry: 5 h + 10 s after a dead run, then helix fan-out again
# (resume_completed skips tasks whose wave/* branch carries its own committed work).

# --- Passata 2 slice preflight ----------------------------------------------
# Product remote is the public repo https://github.com/lucalamalfa91/contigo
# CONTIGO_GITHUB_OWNER=lucalamalfa91
# CONTIGO_GITHUB_REPO=contigo
# CONTIGO_GITHUB_ORG is accepted as an alias for OWNER (legacy).
#
# Required for slices that provision Azure (r0-a, r0-b, r0-d, r0-f, R1–R4).
# Must be the GUID of a dedicated Contigo subscription (display name contains
# "contigo"). "Azure subscription 1" / Free Trial will FAIL the preflight.
# CONTIGO_AZURE_SUBSCRIPTION_ID=
#
# HCP Terraform token if you did not run `terraform login`:
# TF_TOKEN=
# TFE_TOKEN=

# Optional extra HITL sink (Slack incoming webhook or similar). The
# predefined channel is always a GitHub issue labelled `hitl` on
# lucalamalfa91/contigo — see scripts/close_wave_slice.py.
# CONTIGO_HITL_WEBHOOK_URL=

# --- Helix backend (optional) ------------------------------------------------
# If unset, run.sh looks for ../../../helix/src/backend relative to .helix/.
# HELIX_BACKEND=C:/Users/luca.la-malfa/source/repos/helix/src/backend
